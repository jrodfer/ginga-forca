# Perfil de BRouter per córrer (coach/ruta_fixa.py i la ruta a mida de la pàgina de rutes), a partir de
# hiking-mountain.brf de BRouter. Per camins; amb asfalt=1 (profile:asfalt=1 a la petició), per carrers i carreteres
# tranquil·les, i la terra només per enllaçar.
#
# Pistes, carrers i corriols que consta que existeixen. A OpenStreetMap hi ha corriols (highway=path) dibuixats
# sobre marges de camps, fileres d'arbres o olivars que sobre el terreny no hi són (la llarga del 24/10/2026 en
# travessava un olivar). Un corriol compta com a camí de debò si l'OSM en dona alguna prova: és d'un sender
# senyalitzat, o porta la dificultat (sac_scale), la superfície o la visibilitat. Sense cap prova, només s'hi va
# si no hi ha cap altra manera de passar; els informals o poc visibles, mai. Els costos són criteri d'entrenador.

---context:global
assign validForFoot 1
assign turnInstructionMode 1
assign turnInstructionCatchingRange 20
assign uphillcost 0
assign uphillcutoff 1.5
assign downhillcost 0
assign downhillcutoff 1.5
assign asfalt = false   # %asfalt% | Per asfalt: carrers i carreteres tranquil·les abans que camins | boolean

---context:way
assign senyalitzat or route_hiking_iwn=yes or route_hiking_nwn=yes or route_hiking_rwn=yes or route_hiking_lwn=yes
                   or route_hiking_=yes or route_foot_=yes or route_foot_nwn=yes or route_foot_rwn=yes route_foot_lwn=yes
assign provat or senyalitzat or not sac_scale= or not surface= or not trail_visibility= foot=designated
assign amagat or informal=yes trail_visibility=bad|horrible|no
assign accesperpeu switch foot= ( not access=private|no ) ( not foot=private|no|use_sidepath )
assign fora_de_ruta switch senyalitzat 0 0.1      # a igualtat, per on va la gent (senders senyalitzats)

assign pavimentat surface=asphalt|paved|concrete|paving_stones|sett

assign costasfalt
  if highway=footway|pedestrian|living_street|residential|service then switch surface= 1.05 switch pavimentat 1.0 2
  else if highway=cycleway then 1.1
  else if highway=unclassified then 1.2
  else if highway=track|path|bridleway then switch pavimentat 1.2 switch provat 6 10
  else if highway=steps then 3
  else if highway=tertiary|tertiary_link then 2.5
  else if highway=secondary|secondary_link then 6
  else if highway=primary|primary_link|trunk|trunk_link then 20
  else 10000

assign costfactor
  if not accesperpeu then 10000
  else if amagat then 10000
  else if asfalt then costasfalt
  else if highway=track then add fora_de_ruta switch tracktype=grade5 1.2 1.0
  else if highway=path|bridleway then switch provat ( add fora_de_ruta 1.0 ) 10
  else if highway=footway|pedestrian|living_street then 1.1
  else if highway=cycleway then 1.2
  else if highway=residential|service then 1.3
  else if highway=unclassified then 1.5
  else if highway=steps then 2
  else if highway=tertiary|tertiary_link then 3
  else if highway=secondary|secondary_link then 6
  else if highway=primary|primary_link|trunk|trunk_link then 20
  else 10000

# per a les indicacions de gir, com a hiking-mountain.brf
assign priorityclassifier =
  if      highway=motorway|motorway_link|trunk|trunk_link then 28
  else if highway=primary|primary_link then 26
  else if highway=secondary|secondary_link then 24
  else if highway=tertiary|tertiary_link then 22
  else if highway=unclassified then 20
  else if highway=residential|living_street then 18
  else if highway=steps|pedestrian then 16
  else if highway=service|cycleway then 12
  else if highway=track|road|bridleway then 8
  else if highway=path|footway then 3
  else 0
assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = if greater priorityclassifier 19 then true
                       else if highway=residential|living_street|service then true
                       else false
assign classifiermask add multiply isroundabout 4 add multiply islinktype 8 multiply isgoodforcars 16

---context:node
assign initialcost switch or access=private access=no switch foot=yes|designated|permissive 0 1000000 0
